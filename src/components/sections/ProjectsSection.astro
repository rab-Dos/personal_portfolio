    achievements: [
      'Contenido organizado en servicios, preguntas frecuentes, ubicación y contacto.',
      'Pasarela de mensajes animada con Anime.js y controles de navegación entre secciones.',
      'Datos estructurados para el perfil médico y las preguntas frecuentes, junto a un mapa de ubicación embebido.',
    ],
    stack: ['HTML5', 'Tailwind CSS 3', 'JavaScript', 'Anime.js', 'Google Maps'],
    repository: 'https://github.com/rab-Dos/drarreola',
    gallery: [
      {
        avif: '/jesusarellano/images/projects/dr-atzin-arreola/web_draa_1.avif',
        webp: '/jesusarellano/images/projects/dr-atzin-arreola/web_draa_1.webp',
        alt: 'Portada profesional del Dr. Atzin Arreola con su especialidad y acceso a citas.',
      },
      {
        avif: '/jesusarellano/images/projects/dr-atzin-arreola/web_draa_2.avif',
        webp: '/jesusarellano/images/projects/dr-atzin-arreola/web_draa_2.webp',
        alt: 'Sección de presentación del sitio del Dr. Atzin Arreola con su fotografía y texto de bienvenida.',
      },
      {
        avif: '/jesusarellano/images/projects/dr-atzin-arreola/web_draa_3.avif',
