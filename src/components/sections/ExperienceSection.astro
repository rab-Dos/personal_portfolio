    company: 'Alexandria Studio',
    externalLink: 'https://alexandriastudio.cloud/',
    summary:
      'Dirección técnica y visual de la firma, definición de estándares de desarrollo, identidad digital e infraestructura de documentación como código.',
    outcomes: ['Arquitectura de producto', 'Documentation as Code', 'Dirección técnica'],
    modalSections: [],
    highlight: false,
  },
  {
    id: 'twist-and-beat',
