        avif: '/jesusarellano/images/projects/alexandria-studio/web_alex_2.avif',
        webp: '/jesusarellano/images/projects/alexandria-studio/web_alex_2.webp',
        alt: 'Sección de paquetes de servicio de Alexandria Studio con sus opciones de soporte e infraestructura.',
      },
      {
        avif: '/jesusarellano/images/projects/alexandria-studio/web_alex_3.avif',
