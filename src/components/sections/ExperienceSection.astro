          },
          {
            heading: 'Inteligencia de Negocios',
            description: 'Diseñé un Data Lake que alimenta tableros en Power BI para el monitoreo de métricas críticas de servicio, garantías y sostenibilidad (Métricas Verdes).',
          },
        ],
