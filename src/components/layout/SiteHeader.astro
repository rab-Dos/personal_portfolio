---
const brandSources = {
  avif: '/images/brand/original-frente.avif',
  webp: '/images/brand/original-frente.webp',
  png: '/images/brand/original-frente.png',
};
---

<!-- =========================================================================
     NAVEGACIÓN PRINCIPAL
     Barra sticky con glassmorphism, identidad y variantes desktop/móvil.
     ========================================================================= -->
<header class="site-header">
  <nav class="page-container navigation" aria-label="Navegación principal">
    <!-- Identidad de marca: AVIF, WebP y PNG en orden de preferencia -->
    <a class="brand" href="#inicio" aria-label="Jesus Arellano, ir al inicio">
      <picture class="brand-picture">
        <source srcset={brandSources.avif} type="image/avif" />
        <source srcset={brandSources.webp} type="image/webp" />
        <img
          src={brandSources.png}
          width="512"
          height="512"
          alt=""
          decoding="async"
        />
      </picture>
      <span>Jesus Arellano</span>
    </a>

    <!-- Navegación de escritorio: preparada para sumar nuevas secciones -->
    <div class="desktop-navigation">
      <a href="#inicio" aria-current="page">Inicio</a>
      <a href="#experiencia">Experiencia</a>
      <a href="#proyectos">Proyectos</a>
    </div>

    <!-- Controles globales: tema y acceso a navegación móvil -->
    <div class="navigation-actions">
      <button
        class="theme-toggle"
        type="button"
        aria-label="Cambiar al tema oscuro"
        aria-pressed="false"
        data-theme-state="light"
        data-theme-toggle
      >
        <!-- Iconos de tema: el estado actual determina cuál permanece visible -->
        <span class="theme-toggle-icons" aria-hidden="true">
          <svg class="theme-toggle-icon theme-icon-sun" viewBox="0 0 24 24" data-theme-icon="sun">
            <path d="M12 2.75v2.5M12 18.75v2.5M2.75 12h2.5M18.75 12h2.5M5.46 5.46l1.77 1.77M16.77 16.77l1.77 1.77M18.54 5.46l-1.77 1.77M7.23 16.77l-1.77 1.77" />
            <circle cx="12" cy="12" r="3.75" />
          </svg>
          <svg class="theme-toggle-icon theme-icon-moon" viewBox="0 0 24 24" data-theme-icon="moon">
            <path d="M20.25 15.1A8.5 8.5 0 0 1 8.9 3.75a8.5 8.5 0 1 0 11.35 11.35Z" />
          </svg>
        </span>
      </button>

      <!-- Control móvil: transforma la hamburguesa en cierre al desplegar el panel -->
      <button
        class="mobile-navigation-toggle"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-navigation-panel"
        data-mobile-menu-toggle
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </nav>

  <!-- Panel móvil animado; hidden lo retira del orden de foco al cerrarse -->
  <div
    class="mobile-navigation-panel page-container"
    id="mobile-navigation-panel"
    data-mobile-menu
    hidden
  >
    <nav aria-label="Navegación móvil">
      <a href="#inicio" aria-current="page">Inicio</a>
      <a href="#experiencia">Experiencia</a>
      <a href="#proyectos">Proyectos</a>
    </nav>
  </div>

  <!-- Navegación mínima disponible cuando JavaScript está desactivado -->
  <noscript>
    <nav class="mobile-navigation-fallback page-container" aria-label="Navegación móvil">
      <a href="#inicio" aria-current="page">Inicio</a>
      <a href="#experiencia">Experiencia</a>
      <a href="#proyectos">Proyectos</a>
    </nav>
  </noscript>
</header>

<style>
  /* Contenedor sticky sin línea divisoria respecto al hero */
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    height: var(--nav-height);
    background: var(--glass-surface);
    backdrop-filter: blur(1.125rem) saturate(145%);
    -webkit-backdrop-filter: blur(1.125rem) saturate(145%);
  }

  .navigation {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    min-height: var(--nav-height);
  }

  /* Identidad */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    width: fit-content;
    min-height: 2.75rem;
    color: var(--text-strong);
    font-size: 0.9375rem;
    font-weight: var(--font-weight-regular);
    letter-spacing: -0.0125rem;
    text-decoration: none;
  }

  .brand-picture {
    display: grid;
    width: 2.875rem;
    height: 2.875rem;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: var(--surface-muted);
  }

  .brand-picture img {
    width: 2.625rem;
    height: 2.625rem;
    object-fit: contain;
  }

  /* Navegación de escritorio */
  .desktop-navigation {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  .desktop-navigation a,
  .mobile-navigation-panel a {
    min-height: 2.75rem;
    color: var(--text-primary);
    font-size: var(--text-body-sm);
    text-underline-offset: 0.35rem;
  }

  .desktop-navigation a[aria-current='page'],
  .mobile-navigation-panel a[aria-current='page'] {
    color: var(--text-strong);
    text-decoration-thickness: 0.125rem;
  }

  /* Acciones globales */
  .navigation-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .theme-toggle,
  .mobile-navigation-toggle {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid var(--border-control);
    border-radius: var(--radius-button);
    background: var(--surface-muted);
    color: var(--text-primary);
    cursor: pointer;
  }

  /* Botón de tema: intercambio sol/luna y respuesta táctil */
  .theme-toggle {
    position: relative;
    overflow: hidden;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      transform 120ms ease;
  }

  .theme-toggle-icons {
    position: relative;
    display: grid;
    width: 1.25rem;
    height: 1.25rem;
    place-items: center;
  }

  .theme-toggle-icon {
    position: absolute;
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    transition:
      opacity 220ms ease,
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .theme-icon-sun {
    opacity: 0;
    transform: rotate(-80deg) scale(0.55);
  }

  .theme-icon-moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .theme-toggle[data-theme-state='dark'] .theme-icon-sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .theme-toggle[data-theme-state='dark'] .theme-icon-moon {
    opacity: 0;
    transform: rotate(80deg) scale(0.55);
  }

  .theme-toggle:hover {
    background: color-mix(in srgb, var(--surface-muted) 78%, var(--interactive-accent));
    border-color: var(--interactive-accent);
  }

  .theme-toggle:hover .theme-icon-moon {
    transform: rotate(-12deg) scale(1.08);
  }

  .theme-toggle[data-theme-state='dark']:hover .theme-icon-sun {
    transform: rotate(18deg) scale(1.08);
  }

  .theme-toggle:active {
    transform: scale(0.9);
  }

  .theme-toggle:active .theme-toggle-icon {
    transform: rotate(0deg) scale(0.82);
  }

  /* Navegación móvil */
  .mobile-navigation-toggle {
    gap: 0.25rem;
    align-content: center;
  }

  .mobile-navigation-toggle span {
    display: block;
    width: 1.125rem;
    height: 0.09375rem;
    border-radius: var(--radius-pill);
    background: currentColor;
    transition:
      opacity 220ms ease,
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mobile-navigation-toggle.is-active span:nth-child(1) {
    transform: translateY(0.34375rem) rotate(45deg);
  }

  .mobile-navigation-toggle.is-active span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .mobile-navigation-toggle.is-active span:nth-child(3) {
    transform: translateY(-0.34375rem) rotate(-45deg);
  }

  @keyframes mobile-menu-enter {
    from {
      opacity: 0;
      transform: translateY(-0.5rem) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes mobile-menu-exit {
    from {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    to {
      opacity: 0;
      transform: translateY(-0.5rem) scale(0.985);
    }
  }

  .mobile-navigation-panel {
    position: absolute;
    inset-block-start: calc(100% + 0.5rem);
    inset-inline: 0;
    padding: 0.75rem;
    border: 1px solid var(--border-control);
    border-radius: var(--radius-card);
    background: var(--glass-surface);
    backdrop-filter: blur(1.125rem);
    -webkit-backdrop-filter: blur(1.125rem);
    box-shadow: 0 1rem 2.5rem rgb(14 9 24 / 18%);
  }

  .mobile-navigation-panel.is-open {
    animation: mobile-menu-enter 300ms ease-out both;
  }

  .mobile-navigation-panel.is-closing {
    animation: mobile-menu-exit 220ms ease-in both;
  }

  .mobile-navigation-panel[hidden] {
    display: none;
  }

  .mobile-navigation-panel a {
    display: flex;
    align-items: center;
    padding-inline: 0.75rem;
    border-radius: var(--radius-button);
    text-decoration: none;
  }

  .mobile-navigation-panel a:hover {
    background: var(--surface-muted);
  }

  .mobile-navigation-fallback {
    padding-block: 0.75rem;
  }

  @media (min-width: 48rem) {
    .navigation {
      grid-template-columns: 1fr auto 1fr;
    }

    .desktop-navigation {
      display: flex;
    }

    .brand-picture {
      /* En escritorio el mandril gana presencia sin cambiar la altura del navbar */
      width: 4rem;
      height: 4rem;
    }

    .brand-picture img {
      width: 3.75rem;
      height: 3.75rem;
    }

    .mobile-navigation-toggle,
    .mobile-navigation-panel,
    .mobile-navigation-fallback {
      display: none;
    }
  }

  @supports not ((backdrop-filter: blur(1rem)) or (-webkit-backdrop-filter: blur(1rem))) {
    .site-header,
    .mobile-navigation-panel {
      background: var(--surface-page);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-toggle-icon,
    .mobile-navigation-toggle span {
      transition: none;
    }
  }
</style>

<!-- Proporciones críticas inline para conservar el tamaño del logo durante HMR -->
<style is:inline>
  :root {
    --nav-height: 4.75rem;
  }

  .site-header {
    height: var(--nav-height);
  }

  .site-header .navigation {
    min-height: var(--nav-height);
  }

  .site-header .brand-picture {
    width: 2.875rem;
    height: 2.875rem;
  }

  .site-header .brand-picture img {
    width: 2.625rem;
    height: 2.625rem;
  }

  .site-header .theme-toggle,
  .site-header .mobile-navigation-toggle {
    width: 3rem;
    height: 3rem;
  }

  @media (min-width: 48rem) {
    .site-header .brand-picture {
      width: 4rem;
      height: 4rem;
    }

    .site-header .brand-picture img {
      width: 3.75rem;
      height: 3.75rem;
    }
  }
</style>

<script>
  // Mejora progresiva del menú móvil inspirada en el patrón de Alexandria.
  const menuButton = document.querySelector('[data-mobile-menu-toggle]');
  const mobileMenu = document.querySelector('[data-mobile-menu]');

  if (menuButton instanceof HTMLButtonElement && mobileMenu instanceof HTMLElement) {
    const finishClosing = () => {
      mobileMenu.hidden = true;
      mobileMenu.classList.remove('is-closing');
    };

    const closeMenu = (returnFocus = false, immediate = false) => {
      if (mobileMenu.hidden) return;

      menuButton.classList.remove('is-active');
      menuButton.setAttribute('aria-expanded', 'false');
      menuButton.setAttribute('aria-label', 'Abrir menú de navegación');
      mobileMenu.classList.remove('is-open');

      if (immediate) {
        finishClosing();
      } else {
        mobileMenu.classList.add('is-closing');
        mobileMenu.addEventListener('animationend', finishClosing, { once: true });
      }

      if (returnFocus) menuButton.focus();
    };

    const openMenu = () => {
      mobileMenu.hidden = false;
      mobileMenu.classList.remove('is-closing');
      mobileMenu.classList.add('is-open');
      menuButton.classList.add('is-active');
      menuButton.setAttribute('aria-expanded', 'true');
      menuButton.setAttribute('aria-label', 'Cerrar menú de navegación');
    };

    menuButton.addEventListener('click', () => {
      if (mobileMenu.hidden) openMenu();
      else closeMenu();
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => closeMenu());
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !mobileMenu.hidden) closeMenu(true);
    });

    window.matchMedia('(min-width: 48rem)').addEventListener('change', (event) => {
      if (event.matches) closeMenu(false, true);
    });
  }
</script>
