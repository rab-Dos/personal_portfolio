---
import ProjectVisual from './ProjectVisual.astro';
import ProjectGallery from './ProjectGallery.astro';

const projects = [
  {
    index: '01',
    title: 'MCI factuCore',
    client: 'M3 Códice Integral · Cliente Interno',
    description:
      'Pipeline empresarial para ingerir, extraer, validar y persistir órdenes de compra y facturas mediante OCR e inteligencia artificial.',
    achievements: [
      'Definición integral del diccionario técnico, diagramas de arquitectura con Mermaid.js y del identificador único DOCID.',
      'Optimización de FastAPI mediante aislamiento para entornos de alta concurrencia transaccional.',
      'Frontend reactivo con navegación en árbol para consultar expedientes integrados con SharePoint.',
    ],
    stack: ['Python', 'FastAPI', 'MS SQL Server', 'Astro', 'React', 'Tailwind', 'OCR / IA'],
    variant: 'documents' as const,
  },
  {
    index: '02',
    title: 'MCI Human',
    client: 'M3 Códice Integral · Cliente Interno',
    description:
      'Plataforma de capital humano para auditar expedientes, automatizar contratación, validar documentación por OCR y generar contratos con firma digital.',
    achievements: [
      'Funciones y triggers en PL/pgSQL para calcular el cumplimiento documental del expediente.',
      'Integración del ciclo contractual con Cincel API para habilitar firma digital PSC.',
      'Flujos de OCR para extraer CURP, RFC e identificaciones oficiales, entre otros documentos.',
    ],
    stack: ['Python', 'FastAPI', 'PostgreSQL', 'Astro', 'React', 'Tailwind', 'OCR / IA', 'Cincel API'],
    variant: 'people' as const,
  },
  {
    index: '03',
    title: 'MCI Hexagon',
    client: 'M3 Códice Integral',
    description:
      'Arquitectura unificada ERP y plataforma de seguimiento técnico para controlar servicios, almacén e incidencias operativas.',
    achievements: [
      'Optimización del almacenamiento local mediante depuración controlada de logs transaccionales.',
      'SQL Server Agent Job para automatizar el control y escalamiento jerárquico de incidencias y tickets.',
      'Integración de módulos OCR para registrar adquisiciones logísticas de equipos de cómputo e impresión.',
    ],
    stack: ['Python', 'FastAPI', 'MS SQL Server', 'Astro', 'React', 'Tailwind', 'OCR / IA'],
    variant: 'operations' as const,
  },
  {
    index: '04',
    title: 'Control de Incidencias: Auditoría y Analítica de Peaje',
    client: 'Idear Electrónica · Sistema BEA · OPT',
    description:
      'Conciliación de incidencias, disponibilidad de flota y datos masivos de peaje para operaciones críticas de transporte público.',
    achievements: [
      'Desarrollo de sistemas internos para incidencias con C++, C#, .NET y bases transaccionales.',
      'Soporte técnico regional para control de tickets de peaje del Metrobús L2 y Mexibús L3/L4.',
      'Consultoría interna en auditorías anuales bajo los estándares de calidad ISO 9001:2015.',
    ],
    stack: ['PHP', 'MS SQL Server', 'MS Access', 'HTML', 'CSS', 'JS'],
    variant: 'analytics' as const,
  },
