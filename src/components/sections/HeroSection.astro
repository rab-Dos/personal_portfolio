    letter-spacing: -0.045em;
    line-height: 0.95;
    text-wrap: balance;
  }

  /* Énfasis cálido inspirado en la referencia y restringido al mensaje principal */
  .hero-highlight {
    display: block;
    background: var(--gradient-hero-emphasis);
    background-clip: text;
    color: transparent;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-introduction {
