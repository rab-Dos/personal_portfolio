---

<section class="projects-section" id="proyectos" aria-labelledby="projects-title">
  <div class="page-container">
    <!-- Icono copiado desde resources/proyects_icon.svg para uso temático en la interfaz. -->
    <header class="projects-header">
      <div class="projects-intro">
        <h2 class="projects-kicker" id="projects-title">
          <span class="projects-kicker-icon" aria-hidden="true"></span>
          <span>Proyectos</span>
        </h2>
        <p class="projects-lead">Sistemas que resuelven problemas reales</p>
        <p class="projects-description">
          Una selección de soluciones, presentada por problema, logro técnico y stack. Los detalles sensibles se mantienen fuera del dominio público.
        </p>
      </div>
      <div class="projects-art" aria-hidden="true">
        <picture data-project-art>
          <source
            srcset="/jesusarellano/images/brand/frontal.avif"
            data-enterprise-srcset="/jesusarellano/images/brand/frontal.avif"
            data-web-srcset="/jesusarellano/images/brand/frontal_molesto.avif"
            type="image/avif"
          />
          <source
            srcset="/jesusarellano/images/brand/frontal.webp"
            data-enterprise-srcset="/jesusarellano/images/brand/frontal.webp"
            data-web-srcset="/jesusarellano/images/brand/frontal_molesto.webp"
            type="image/webp"
          />
          <img
            src="/jesusarellano/images/brand/frontal.png"
            data-enterprise-src="/jesusarellano/images/brand/frontal.png"
            data-web-src="/jesusarellano/images/brand/frontal_molesto.png"
            width="800"
            height="800"
    alt=""
    loading="lazy"
    decoding="async"
          />
        </picture>
      </div>
    </header>

    <div class="projects-switcher" data-projects-tabs>
      <div class="projects-tablist" role="tablist" aria-label="Categorías de proyectos" hidden>
        <button
          class="projects-tab"
          id="projects-tab-enterprise"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="projects-panel-enterprise"
          data-project-tab
        >
          <span>Sistemas Empresariales</span>
        </button>
        <button
          class="projects-tab"
          id="projects-tab-web"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="projects-panel-web"
          data-project-tab
        >
          <span>Sitios Web</span>
        </button>
      </div>

      <section class="projects-panel" id="projects-panel-enterprise" data-project-panel>
        <h3 class="visually-hidden">Sistemas Empresariales</h3>
        <div class="projects-grid">
          {projects.map((project) => (
            <article class="project-card" aria-labelledby={`project-${project.index}-title`}>
              <div class="project-card-content">
                <div class="project-copy">
                  <div class="project-card-meta">
                    <span class="project-index">{project.index}</span>
                    <span class="project-client">{project.client}</span>
                    <span class="project-type">Arquitectura privada</span>
                  </div>

                  <h3 id={`project-${project.index}-title`}>{project.title}</h3>
                  <p class="project-description">{project.description}</p>

                  <section class="project-achievements" aria-labelledby={`project-${project.index}-achievements`}>
                    <h4 id={`project-${project.index}-achievements`}>Logros clave</h4>
                    <ul>
                      {project.achievements.map((achievement) => (
                        <li><span aria-hidden="true"></span>{achievement}</li>
                      ))}
                    </ul>
                  </section>
                </div>

                <div class="project-visual-column">
                  <div class="project-visual-frame">
                    <ProjectVisual variant={project.variant} label={project.title} />
                  </div>
                  <ul class="project-stack" aria-label={`Tecnologías utilizadas en ${project.title}`}>
                    {project.stack.map((technology) => <li>{technology}</li>)}
                  </ul>
                </div>
              </div>

              <p class="project-note">
                <span class="project-note-icon" aria-hidden="true"></span>
                <span>Detalle arquitectónico disponible en conversación técnica, se contempla la solución de las necesidades expuestas, no así el producto mencionado.</span>
              </p>
            </article>
          ))}
        </div>
      </section>

      <section class="projects-panel projects-web-panel" id="projects-panel-web" data-project-panel>
        <h3 class="visually-hidden">Sitios Web</h3>
        <div class="projects-grid">
          {webProjects.map((project) => (
            <article class="project-card project-card-web" aria-labelledby={`project-web-${project.index}-title`}>
              <div class="project-card-content">
                <div class="project-copy">
                  <div class="project-card-meta">
                    <span class="project-index">{project.index}</span>
                    <span class="project-client">{project.client}</span>
                  </div>

                  <h3 id={`project-web-${project.index}-title`}>{project.title}</h3>
                  <p class="project-description">{project.description}</p>

                  <section class="project-achievements" aria-labelledby={`project-web-${project.index}-achievements`}>
                    <h4 id={`project-web-${project.index}-achievements`}>Logros clave</h4>
                    <ul>
                      {project.achievements.map((achievement) => (
                        <li><span aria-hidden="true"></span>{achievement}</li>
                      ))}
                    </ul>
                  </section>

                </div>

                <div class="project-visual-column">
                  <ProjectGallery label={project.title} images={project.gallery} />
                  <ul class="project-stack" aria-label={`Tecnologías utilizadas en ${project.title}`}>
                    {project.stack.map((technology) => <li>{technology}</li>)}
                  </ul>
                  <div class="project-actions" aria-label={`Enlaces externos de ${project.title}`}>
                    <a
                      class="project-link"
                      href={project.repository}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Repositorio en GitHub
                      <span class="visually-hidden"> (abre en una pestaña nueva)</span>
                    </a>
                    {'liveSite' in project && (
                      <a
                        class="project-link project-link-secondary"
                        href={project.liveSite}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Visitar sitio
                        <span class="visually-hidden"> (abre en una pestaña nueva)</span>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-projects-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-project-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-project-panel]'));
    const tablist = root.querySelector<HTMLElement>('[role="tablist"]');
    const art = root.closest<HTMLElement>('.projects-section')?.querySelector<HTMLPictureElement>('[data-project-art]');
    let currentArtVariant: 'enterprise' | 'web' = 'enterprise';
    let artTransitionVersion = 0;

    if (!tablist || tabs.length !== panels.length || tabs.length === 0) return;

    panels.forEach((panel, index) => {
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', tabs[index].id);
      panel.tabIndex = 0;
    });

    const transitionArt = async (variant: 'enterprise' | 'web') => {
      if (!art || variant === currentArtVariant) return;

      const image = art.querySelector<HTMLImageElement>('img[data-enterprise-src]');
      if (!image) return;

      const transitionVersion = ++artTransitionVersion;
      const shouldAnimate = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      currentArtVariant = variant;
      if (shouldAnimate) art.classList.add('is-transitioning');

      if (shouldAnimate) {
        await new Promise<void>((resolve) => {
          let settled = false;
          const finish = () => {
            if (settled) return;
            settled = true;
            window.clearTimeout(fallbackTimer);
            image.removeEventListener('transitionend', handleTransitionEnd);
            resolve();
          };
          const handleTransitionEnd = (event: TransitionEvent) => {
            if (event.target === image && event.propertyName === 'opacity') finish();
          };
          const fallbackTimer = window.setTimeout(finish, 320);
          image.addEventListener('transitionend', handleTransitionEnd);
        });
      }

      if (transitionVersion !== artTransitionVersion) return;

      art.querySelectorAll<HTMLSourceElement>('source[data-enterprise-srcset]').forEach((source) => {
        const srcset = source.dataset[`${variant}Srcset`];
        if (srcset) source.srcset = srcset;
      });
      const src = image.dataset[`${variant}Src`];
      if (src) image.src = src;

      try {
        await image.decode();
      } catch {
        // Reveal the image even if its decoder rejects the request.
      }

      if (shouldAnimate && transitionVersion === artTransitionVersion) {
        requestAnimationFrame(() => {
          if (transitionVersion === artTransitionVersion) art.classList.remove('is-transitioning');
        });
      }
    };

    const selectTab = (selectedIndex: number, moveFocus = false) => {
      tabs.forEach((tab, index) => {
        const selected = index === selectedIndex;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        panels[index].hidden = !selected;
      });

      void transitionArt(selectedIndex === 1 ? 'web' : 'enterprise');

      panels[selectedIndex].dispatchEvent(new Event('project-panel-shown'));

      if (moveFocus) tabs[selectedIndex].focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(index));
      tab.addEventListener('keydown', (event) => {
        let nextIndex: number | undefined;

        switch (event.key) {
          case 'ArrowRight':
            nextIndex = (index + 1) % tabs.length;
            break;
          case 'ArrowLeft':
            nextIndex = (index - 1 + tabs.length) % tabs.length;
            break;
          case 'Home':
            nextIndex = 0;
            break;
          case 'End':
            nextIndex = tabs.length - 1;
            break;
        }

        if (nextIndex !== undefined) {
          event.preventDefault();
          selectTab(nextIndex, true);
        }
      });
    });

    selectTab(0);
    tablist.hidden = false;
  });
</script>

<style>
  .projects-section {
    position: relative;
    overflow: clip;
    padding-block: clamp(5rem, 10vw, 8rem);
    background:
      radial-gradient(ellipse 60% 45% at 0% 0%, var(--ambient-current), transparent 72%),
      var(--surface-page);
  }

  .projects-section::before {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--border-subtle) 20%,
      var(--interactive-accent) 50%,
      var(--border-subtle) 80%,
      transparent
    );
    content: '';
    opacity: 0.85;
  }

  .projects-header {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: center;
    padding-block-end: clamp(3rem, 7vw, 5rem);
  }

  .projects-intro {
    max-width: 48rem;
    position: relative;
    z-index: 1;
  }

  .projects-art {
    position: relative;
    display: grid;
    width: min(100%, 25rem);
    aspect-ratio: 1;
    place-items: center;
    justify-self: end;
    isolation: isolate;
  }

  .projects-art::before {
    position: absolute;
    inset: 4%;
    z-index: -1;
    border-radius: var(--radius-pill);
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--hero-emphasis-color) 22%, transparent),
      transparent 68%
    );
    content: '';
    filter: blur(1.4rem);
  }

  .projects-art picture,
  .projects-art img {
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
  }

  .projects-art img {
    object-fit: contain;
    transition:
      opacity 240ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .projects-art picture.is-transitioning img {
    opacity: 0;
    transform: scale(0.96);
  }

  .projects-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1rem;
    color: var(--hero-emphasis-color);
    font-size: 0.75rem;
    font-weight: var(--font-weight-regular);
    letter-spacing: 0.12em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .projects-kicker-icon {
    display: inline-block;
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    background: currentColor;
    mask: url('/jesusarellano/images/icons/projects-icon.svg') center / contain no-repeat;
    -webkit-mask: url('/jesusarellano/images/icons/projects-icon.svg') center / contain no-repeat;
  }

  .projects-kicker::before {
    width: 1.25rem;
    height: 1px;
    flex: 0 0 auto;
    background: var(--hero-emphasis-color);
    content: '';
  }

  .projects-lead {
    max-width: 40rem;
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(2.75rem, 6vw, 5rem);
    font-weight: var(--font-weight-light);
    letter-spacing: -0.05em;
    line-height: 0.94;
  }

  .projects-description {
    max-width: 38rem;
    margin: 1rem 0 0;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .projects-tablist {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-block-end: 2rem;
  }

  .projects-tablist[hidden] {
    display: none;
  }

  .projects-tab {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--border-control);
    border-radius: var(--radius-button);
    background: var(--surface-muted);
    color: var(--text-primary);
    cursor: pointer;
    font-size: var(--text-body-sm);
    text-align: center;
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }

  .projects-tab[aria-selected='true'] {
    border-color: var(--hero-emphasis-color);
    background: color-mix(in srgb, var(--hero-emphasis-color) 13%, var(--surface-card));
    color: var(--hero-emphasis-color);
  }

  .projects-tab:hover {
    transform: translateY(-2px);
  }

  .projects-tab:hover:not([aria-selected='true']) {
    border-color: var(--hero-emphasis-color);
    background: color-mix(in srgb, var(--hero-emphasis-color) 7%, var(--surface-muted));
  }

  .projects-tab:focus-visible {
    outline: 2px solid var(--interactive-accent);
    outline-offset: 3px;
  }

  .projects-panel[hidden] {
    display: none;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-rows: auto;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .project-card {
    display: flex;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: stretch;
    padding: clamp(1rem, 2vw, 1.5rem);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-panel);
