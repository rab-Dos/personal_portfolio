  {
    id: 'm3-codice',
    period: '2021 — Presente',
    role: 'Technical Lead & Database Architect',
    company: 'M3 Códice Integral',
    externalLink: null,
    summary:
      'Liderazgo técnico, arquitectura de soluciones, modelado de datos e integraciones empresariales para productos con alta carga documental y operativa. Promovido para liderar la célula de desarrollo e innovación de la organización, transformando procesos operativos tradicionales en ecosistemas digitales unificados y escalables.',
    outcomes: ['Arquitecturas concurrentes', 'Gobierno de datos', 'Integraciones críticas'],
    modalSections: [
      {
        title: 'Logros e impacto',
        items: [
          {
            heading: 'Arquitectura de Software (Proyecto Hexagon)',
            description: 'Lidero el diseño y desarrollo de un ERP centralizado en MS SQL Server para unificar la operación global de la empresa, eliminando silos de información.',
