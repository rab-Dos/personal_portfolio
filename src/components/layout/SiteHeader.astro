---
import SoundToggle from '../ui/SoundToggle.astro';
import ControlTooltip from '../ui/ControlTooltip.astro';
const brandSources = {
  avif: '/jesusarellano/images/brand/original-frente.avif',
  webp: '/jesusarellano/images/brand/original-frente.webp',
  png: '/jesusarellano/images/brand/original-frente.png',
};
---

<!-- =========================================================================
     NAVEGACIÓN PRINCIPAL
     Barra sticky con glassmorphism, identidad y variantes desktop/móvil.
     ========================================================================= -->
<header class="site-header">
  <div class="mobile-navigation-backdrop" data-mobile-menu-backdrop hidden></div>
  <nav class="page-container navigation" aria-label="Navegación principal">
    <!-- Identidad de marca: AVIF, WebP y PNG en orden de preferencia -->
    <a class="brand" href="#inicio" aria-label="Jesus Arellano, ir al inicio">
      <picture class="brand-picture">
        <source srcset={brandSources.avif} type="image/avif" />
        <source srcset={brandSources.webp} type="image/webp" />
        <img
          src={brandSources.png}
          width="512"
          height="512"
          alt=""
          decoding="async"
        />
      </picture>
      <span>Jesus Arellano</span>
    </a>

    <!-- Navegación de escritorio: preparada para sumar nuevas secciones -->
    <div class="desktop-navigation">
      <a href="#inicio" aria-current="location">Inicio</a>
      <a href="#experiencia">Experiencia</a>
      <a href="#proyectos">Proyectos</a>
      <a href="#sobre-mi">Sobre Mí</a>
      <a href="#contacto">Contacto</a>
      <span class="desktop-section-indicator" aria-hidden="true"></span>
    </div>

    <!-- Controles globales: tema y acceso a navegación móvil -->
    <div class="navigation-actions">
      <div class="desktop-sound-control"><SoundToggle /></div>
      <button
        class="theme-toggle"
        type="button"
        aria-label="Cambiar al tema oscuro"
        aria-pressed="false"
        data-theme-state="light"
        data-theme-toggle
        data-tooltip-control
        aria-describedby="theme-tooltip"
      >
        <!-- Iconos de tema: el estado actual determina cuál permanece visible -->
        <span class="theme-toggle-icons" aria-hidden="true">
          <svg class="theme-toggle-icon theme-icon-sun" viewBox="0 0 24 24" data-theme-icon="sun">
            <path d="M12 2.75v2.5M12 18.75v2.5M2.75 12h2.5M18.75 12h2.5M5.46 5.46l1.77 1.77M16.77 16.77l1.77 1.77M18.54 5.46l-1.77 1.77M7.23 16.77l-1.77 1.77" />
            <circle cx="12" cy="12" r="3.75" />
          </svg>
          <svg class="theme-toggle-icon theme-icon-moon" viewBox="0 0 24 24" data-theme-icon="moon">
            <path d="M20.25 15.1A8.5 8.5 0 0 1 8.9 3.75a8.5 8.5 0 1 0 11.35 11.35Z" />
          </svg>
        </span>
        <ControlTooltip id="theme-tooltip" text="Cambiar al tema oscuro" placement="below" />
      </button>

      <!-- Control móvil: transforma la hamburguesa en cierre al desplegar el panel -->
      <button
        class="mobile-navigation-toggle"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-navigation-panel"
        data-mobile-menu-toggle
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </nav>

  <!-- Panel móvil animado; hidden lo retira del orden de foco al cerrarse -->
  <div
    class="mobile-navigation-panel page-container"
    id="mobile-navigation-panel"
    data-mobile-menu
    hidden
  >
    <nav aria-label="Navegación móvil">
      <a href="#inicio" aria-current="location">Inicio</a>
      <a href="#experiencia">Experiencia</a>
      <a href="#proyectos">Proyectos</a>
      <a href="#sobre-mi">Sobre Mí</a>
      <a href="#contacto">Contacto</a>
    </nav>
    <div class="mobile-sound-option"><SoundToggle menu /></div>
  </div>

  <!-- Navegación mínima disponible cuando JavaScript está desactivado -->
  <noscript>
    <nav class="mobile-navigation-fallback page-container" aria-label="Navegación móvil">
      <a href="#inicio" aria-current="location">Inicio</a>
      <a href="#experiencia">Experiencia</a>
      <a href="#proyectos">Proyectos</a>
      <a href="#sobre-mi">Sobre Mí</a>
      <a href="#contacto">Contacto</a>
    </nav>
  </noscript>
</header>

<style>
  /* Marco flotante con esquinas suaves y cristal independiente de la transición de página. */
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    height: calc(var(--nav-height) + 0.75rem);
    padding-block-start: 0.75rem;
  }

  .navigation {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    min-height: var(--nav-height);
    padding-inline: 1.25rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-navigation);
    corner-shape: squircle;
    background: var(--glass-surface);
    backdrop-filter: var(--glass-filter);
    -webkit-backdrop-filter: var(--glass-filter);
    box-shadow: var(--nav-inset-edge);
    view-transition-name: site-navigation;
  }

  /* Identidad */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    width: fit-content;
    min-height: 2.75rem;
    color: var(--text-strong);
    font-size: 0.9375rem;
    font-weight: var(--font-weight-regular);
    letter-spacing: -0.0125rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand-picture {
    display: grid;
    width: 2.875rem;
    height: 2.875rem;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: var(--surface-muted);
    flex: 0 0 auto;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 260ms ease;
  }

  .brand-picture img {
    width: 2.625rem;
    height: 2.625rem;
    object-fit: contain;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .brand:is(:hover, :focus-visible) .brand-picture {
    transform: scale(1.04);
    box-shadow:
      0 0 0 1px var(--hero-emphasis-color),
      0 0 1.25rem color-mix(in srgb, var(--hero-emphasis-color) 30%, transparent),
      inset 0 0 0.75rem color-mix(in srgb, var(--hero-emphasis-color) 14%, transparent);
  }

  .brand:is(:hover, :focus-visible) .brand-picture img {
    transform: rotate(-4deg) scale(1.06);
  }

  /* Navegación de escritorio */
  .desktop-navigation {
    position: relative;
    display: none;
    align-items: center;
    justify-content: center;
    gap: clamp(1.25rem, 2.2vw, 2rem);
    justify-self: center;
  }

  .desktop-section-indicator {
    position: absolute;
    inset-inline-start: 0;
    inset-block-end: 0.375rem;
    width: 0.75rem;
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--interactive-accent);
    opacity: 0;
    pointer-events: none;
    transform: translateX(var(--section-indicator-x, 0px));
  }

  .desktop-navigation.has-section-indicator .desktop-section-indicator {
    opacity: 1;
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1), opacity 180ms ease;
  }

  .desktop-navigation.has-section-indicator a[aria-current='location']::before {
    display: none;
  }

  .desktop-navigation:has(a[aria-current='location']:is(:hover, :focus-visible)) .desktop-section-indicator {
    opacity: 0;
  }

  .desktop-navigation a,
  .mobile-navigation-panel a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text-primary);
    font-size: var(--text-body-sm);
    line-height: 1.4;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .desktop-navigation a {
    justify-content: center;
  }

  .desktop-navigation a::after,
  .mobile-navigation-panel a::after {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0.375rem;
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--gradient-electric-current);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
    content: '';
  }

  .desktop-navigation a:is(:hover, :focus-visible),
  .mobile-navigation-panel a:is(:hover, :focus-visible) {
    color: var(--interactive-accent);
  }

  .desktop-navigation a:is(:hover, :focus-visible)::after,
  .mobile-navigation-panel a:is(:hover, :focus-visible)::after {
    transform: scaleX(1);
  }

  .desktop-navigation a[aria-current='location']:not(:hover, :focus-visible),
  .mobile-navigation-panel a[aria-current='location']:not(:hover, :focus-visible) {
    color: var(--text-strong);
  }

  /* Marca persistente de sección; la línea de hover se dibuja por separado. */
  .desktop-navigation a[aria-current='location']::before,
  .mobile-navigation-panel a[aria-current='location']::before {
    position: absolute;
    inset-block-end: 0.375rem;
    inset-inline-start: calc(50% - 0.375rem);
    width: 0.75rem;
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--interactive-accent);
    transition: opacity 180ms ease;
    content: '';
  }

  .desktop-navigation a[aria-current='location']:is(:hover, :focus-visible)::before,
  .mobile-navigation-panel a[aria-current='location']:is(:hover, :focus-visible)::before {
    opacity: 0;
  }

  /* Acciones globales */
  .navigation-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .desktop-sound-control { display: none; }
  .mobile-sound-option {
    margin-block-start: 0.5rem;
    padding-block-start: 0.75rem;
    border-block-start: 1px solid var(--border-subtle);
  }

  .theme-toggle,
  .mobile-navigation-toggle {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid var(--border-control);
    border-radius: var(--radius-button);
    background: color-mix(in srgb, var(--surface-muted) 72%, transparent);
    color: var(--text-primary);
    cursor: pointer;
  }

  /* Botón de tema: intercambio sol/luna y respuesta táctil */
  .theme-toggle {
    position: relative;
    overflow: visible;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      transform 140ms ease;
  }

  .theme-toggle-icons {
    position: relative;
    overflow: hidden;
    display: grid;
    width: 1.25rem;
    height: 1.25rem;
    place-items: center;
  }

  .theme-toggle-icon {
    position: absolute;
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    transition:
      opacity 220ms ease,
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .theme-icon-sun {
    opacity: 0;
    transform: rotate(-80deg) scale(0.55);
  }

  .theme-icon-moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .theme-toggle[data-theme-state='dark'] .theme-icon-sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .theme-toggle[data-theme-state='dark'] .theme-icon-moon {
    opacity: 0;
    transform: rotate(80deg) scale(0.55);
  }

  .theme-toggle:hover {
    transform: translateY(-0.125rem);
    background: var(--surface-muted);
    border-color: var(--interactive-accent);
  }

  .theme-toggle:active {
    transform: translateY(0) scale(0.98);
  }

  /* El cambio de paleta no interpola colores capturados; hover conserva su movimiento. */
  :global(html.is-changing-theme) .theme-toggle {
    transition: transform 140ms ease;
  }

  :global(html.is-changing-theme) .brand-picture {
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(html.is-changing-theme) .desktop-navigation a,
  :global(html.is-changing-theme) .mobile-navigation-panel a {
    transition: none;
  }

  :global(html.is-changing-theme) .mobile-navigation-backdrop {
    transition: backdrop-filter 220ms ease, -webkit-backdrop-filter 220ms ease;
  }

  /* Navegación móvil */
  .mobile-navigation-toggle {
    gap: 0.25rem;
    align-content: center;
  }

  .mobile-navigation-toggle span {
    display: block;
    width: 1.125rem;
    height: 0.09375rem;
    border-radius: var(--radius-pill);
    background: currentColor;
    transition:
      opacity 220ms ease,
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mobile-navigation-toggle.is-active span:nth-child(1) {
    transform: translateY(0.34375rem) rotate(45deg);
  }

  .mobile-navigation-toggle.is-active span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .mobile-navigation-toggle.is-active span:nth-child(3) {
    transform: translateY(-0.34375rem) rotate(-45deg);
  }

  @keyframes mobile-menu-enter {
    from {
      opacity: 0;
      transform: translateY(-0.5rem) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes mobile-menu-exit {
    from {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    to {
      opacity: 0;
      transform: translateY(-0.5rem) scale(0.985);
    }
  }

  .mobile-navigation-panel {
    position: absolute;
    inset-block-start: calc(100% + 0.5rem);
    inset-inline: 0;
    z-index: 2;
    padding: 0.75rem;
    border: 1px solid var(--border-control);
    border-radius: var(--radius-navigation);
    corner-shape: squircle;
    background: color-mix(in srgb, var(--surface-card) 90%, transparent);
    backdrop-filter: var(--glass-filter);
    -webkit-backdrop-filter: var(--glass-filter);
    box-shadow: var(--nav-inset-edge);
    view-transition-name: mobile-navigation;
  }

  .mobile-navigation-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1;
    background-color: transparent;
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
    transition: background-color 220ms ease, backdrop-filter 220ms ease, -webkit-backdrop-filter 220ms ease;
  }

  .mobile-navigation-backdrop.is-visible {
    background-color: color-mix(in srgb, var(--surface-page) 58%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .mobile-navigation-backdrop[hidden] {
    display: none;
  }

  :global(html.mobile-menu-open) {
    overflow: hidden;
  }

  .mobile-navigation-panel.is-open {
    animation: mobile-menu-enter 300ms ease-out both;
  }

  .mobile-navigation-panel.is-closing {
    animation: mobile-menu-exit 220ms ease-in both;
  }

  .mobile-navigation-panel[hidden] {
    display: none;
  }

  .mobile-navigation-panel a {
    display: flex;
    align-items: center;
    padding-inline: 0.75rem;
    border-radius: var(--radius-button);
    text-decoration: none;
  }

  .mobile-navigation-panel a::after {
    inset-inline: 0.75rem;
  }

  .mobile-navigation-panel a[aria-current='location']::before {
    inset-inline-start: 0.75rem;
  }

  .mobile-navigation-fallback {
    padding-block: 0.75rem;
  }

  @media (max-width: 22.5rem) {
    .navigation {
      padding-inline: 0.75rem;
    }

    .brand {
      gap: 0.375rem;
      font-size: 0.8125rem;
      white-space: nowrap;
    }

    .brand-picture {
      width: 2.5rem;
      height: 2.5rem;
    }

    .brand-picture img {
      width: 2.25rem;
      height: 2.25rem;
    }

    .navigation-actions {
      gap: 0.375rem;
    }

    .theme-toggle,
    .mobile-navigation-toggle {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  @media (min-width: 64rem) {
    .desktop-sound-control { display: flex; }
    .theme-toggle {
      border-radius: var(--radius-pill);
    }

    .navigation {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    }

    .desktop-navigation {
      display: flex;
    }

    .brand-picture {
      width: 3rem;
      height: 3rem;
    }

    .brand-picture img {
      width: 2.75rem;
      height: 2.75rem;
    }

    .mobile-navigation-toggle,
    .mobile-navigation-panel,
    .mobile-navigation-backdrop,
    .mobile-navigation-fallback {
      display: none;
    }
  }

  @supports not ((backdrop-filter: blur(1rem)) or (-webkit-backdrop-filter: blur(1rem))) {
    .navigation,
    .mobile-navigation-panel {
      background: var(--surface-card);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-toggle-icon,
    .brand-picture,
    .brand-picture img,
    .desktop-navigation a,
    .desktop-navigation a::before,
    .desktop-navigation a::after,
    .desktop-navigation.has-section-indicator .desktop-section-indicator,
    .mobile-navigation-panel a,
    .mobile-navigation-panel a::before,
    .mobile-navigation-panel a::after,
    .mobile-navigation-toggle span,
    .mobile-navigation-backdrop {
      transition: none;
    }

    .brand:is(:hover, :focus-visible) .brand-picture,
    .brand:is(:hover, :focus-visible) .brand-picture img,
    .theme-toggle:hover,
    .theme-toggle:active {
      transform: none;
    }
  }
</style>

<!-- Proporciones críticas inline para conservar el tamaño del logo durante HMR -->
<style is:inline>
  :root {
    --nav-height: 4.25rem;
  }

  .site-header {
    height: calc(var(--nav-height) + 0.75rem);
  }

  .site-header .navigation {
    min-height: var(--nav-height);
  }

  .site-header .brand-picture {
    width: 2.875rem;
    height: 2.875rem;
  }

  .site-header .brand-picture img {
    width: 2.625rem;
    height: 2.625rem;
  }

  .site-header .theme-toggle,
  .site-header .mobile-navigation-toggle {
    width: 3rem;
    height: 3rem;
  }

  @media (max-width: 22.5rem) {
    .site-header .brand-picture {
      width: 2.5rem;
      height: 2.5rem;
    }

    .site-header .brand-picture img {
      width: 2.25rem;
      height: 2.25rem;
    }

    .site-header .theme-toggle,
    .site-header .mobile-navigation-toggle {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  @media (min-width: 64rem) {
    .site-header .brand-picture {
      width: 3rem;
      height: 3rem;
    }

    .site-header .brand-picture img {
      width: 2.75rem;
      height: 2.75rem;
    }
  }
</style>

<script>
  import { playSound } from '../../scripts/sounds';
  // Sincroniza ambos menús con la sección que ocupa el área de lectura bajo el navbar.
  const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.desktop-navigation a, .mobile-navigation-panel a'));
  const sections = Array.from(new Set(sectionLinks.map((link) => link.hash)))
    .map((hash) => document.getElementById(hash.slice(1)))
    .filter((section): section is HTMLElement => section instanceof HTMLElement);
  const header = document.querySelector('.site-header');
  const desktopNavigation = document.querySelector<HTMLElement>('.desktop-navigation');
  const desktopIndicator = desktopNavigation?.querySelector<HTMLElement>('.desktop-section-indicator');
  let currentSection = '';
  let sectionFrame: number | undefined;

  const updateDesktopIndicator = (sectionId: string) => {
    if (!desktopNavigation || !desktopIndicator || !desktopNavigation.offsetWidth) return;
    const activeLink = desktopNavigation.querySelector<HTMLAnchorElement>(`a[href="#${sectionId}"]`);
    if (!activeLink) return;
    const linkBounds = activeLink.getBoundingClientRect();
    const navBounds = desktopNavigation.getBoundingClientRect();
    const position = linkBounds.left - navBounds.left + (linkBounds.width - desktopIndicator.offsetWidth) / 2;
    desktopNavigation.style.setProperty('--section-indicator-x', `${position}px`);
    if (!desktopNavigation.classList.contains('has-section-indicator')) {
      window.requestAnimationFrame(() => desktopNavigation.classList.add('has-section-indicator'));
    }
  };

  const updateCurrentSection = () => {
    sectionFrame = undefined;
    if (!sections.length) return;
    const readingLine = Math.max((header?.getBoundingClientRect().bottom ?? 0) + 24, window.innerHeight * 0.3);
    let activeSection = sections[0];
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= readingLine) activeSection = section;
      else break;
    }
    if (window.scrollY > 0 && window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
      activeSection = sections[sections.length - 1];
    }
    updateDesktopIndicator(activeSection.id);
    if (currentSection === activeSection.id) return;
    currentSection = activeSection.id;
    sectionLinks.forEach((link) => {
      if (link.hash === `#${currentSection}`) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };

  const scheduleSectionUpdate = () => {
    if (sectionFrame === undefined) sectionFrame = window.requestAnimationFrame(updateCurrentSection);
  };
  window.addEventListener('scroll', scheduleSectionUpdate, { passive: true });
  window.addEventListener('resize', scheduleSectionUpdate);
  window.addEventListener('pageshow', scheduleSectionUpdate);
  const sectionResizeObserver = new ResizeObserver(scheduleSectionUpdate);
  sections.forEach((section) => sectionResizeObserver.observe(section));
  if (desktopNavigation) sectionResizeObserver.observe(desktopNavigation);
  document.fonts.ready.then(scheduleSectionUpdate);
  updateCurrentSection();

  // Mejora progresiva del menú móvil inspirada en el patrón de Alexandria.
  const menuButton = document.querySelector('[data-mobile-menu-toggle]');
  const mobileMenu = document.querySelector('[data-mobile-menu]');
  const menuBackdrop = document.querySelector('[data-mobile-menu-backdrop]');

  if (menuButton instanceof HTMLButtonElement && mobileMenu instanceof HTMLElement && menuBackdrop instanceof HTMLElement) {
    let closeTimer: number | undefined;

    const finishClosing = () => {
      mobileMenu.hidden = true;
      mobileMenu.classList.remove('is-closing');
      menuBackdrop.hidden = true;
      menuBackdrop.classList.remove('is-visible');
    };

    const closeMenu = (returnFocus = false, immediate = false, audible = true) => {
      if (!mobileMenu.classList.contains('is-open')) return;
      if (!immediate && audible) playSound('close');

      mobileMenu.inert = true;
      menuButton.classList.remove('is-active');
      menuButton.setAttribute('aria-expanded', 'false');
      menuButton.setAttribute('aria-label', 'Abrir menú de navegación');
      mobileMenu.classList.remove('is-open');
      menuBackdrop.classList.remove('is-visible');
      document.documentElement.classList.remove('mobile-menu-open');
      window.clearTimeout(closeTimer);

      if (immediate || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        finishClosing();
      } else {
        mobileMenu.classList.add('is-closing');
        closeTimer = window.setTimeout(finishClosing, 220);
      }

      if (returnFocus) menuButton.focus();
    };

    const openMenu = () => {
      playSound('open');
      window.clearTimeout(closeTimer);
      menuBackdrop.hidden = false;
      mobileMenu.hidden = false;
      mobileMenu.inert = false;
      mobileMenu.classList.remove('is-closing');
      mobileMenu.classList.add('is-open');
      document.documentElement.classList.add('mobile-menu-open');
      menuButton.classList.add('is-active');
      menuButton.setAttribute('aria-expanded', 'true');
      menuButton.setAttribute('aria-label', 'Cerrar menú de navegación');
      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(() => {
          if (mobileMenu.classList.contains('is-open')) menuBackdrop.classList.add('is-visible');
          scheduleSectionUpdate();
        });
      });
    };

    menuButton.addEventListener('click', () => {
      if (!mobileMenu.classList.contains('is-open')) openMenu();
      else closeMenu();
    });

    menuBackdrop.addEventListener('click', () => closeMenu(true));

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => closeMenu(false, false, false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobileMenu.classList.contains('is-open')) closeMenu(true);
    });

    window.matchMedia('(min-width: 64rem)').addEventListener('change', (event) => {
      if (event.matches) closeMenu(false, true);
    });
  }
</script>
