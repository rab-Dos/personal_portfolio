    role: 'Freelance Full Stack Developer & Lead',
    company: 'Twist & Beat',
    externalLink: null,
    summary:
      'Gestión y ejecución integral de proyectos tecnológicos personalizados, abarcando desde el levantamiento de requerimientos hasta el despliegue y mantenimiento de soluciones digitales.',
    outcomes: ['Full stack', 'Ciclo de vida completo', 'Entrega continua'],
    modalSections: [
      {
