---
interface GalleryImage {
  avif: string;
  webp: string;
  alt: string;
}

interface Props {
  label: string;
  images: GalleryImage[];
}

const { label, images } = Astro.props;
---

<div
  class="project-gallery"
  data-project-gallery
  role="group"
  aria-roledescription="carrusel"
  aria-label={`Capturas de ${label}`}
>
  <div
    class="project-gallery-viewport"
    data-gallery-viewport
    tabindex="0"
    aria-label="Galería de capturas; desplázate horizontalmente para ver más"
  >
    <ol class="project-gallery-track">
      {images.map((image, index) => (
        <li
          class="project-gallery-slide"
          data-gallery-slide
          role="group"
          aria-roledescription="diapositiva"
          aria-label={`${index + 1} de ${images.length}`}
          aria-current={index === 0 ? 'true' : undefined}
        >
          <figure>
            <picture>
              <source srcset={image.avif} type="image/avif" />
              <img
                src={image.webp}
                width="800"
                height="500"
                alt={image.alt}
                loading="lazy"
                decoding="async"
              />
            </picture>
          </figure>
        </li>
      ))}
    </ol>
  </div>

  <div
    class="project-gallery-controls"
    data-gallery-controls
    role="group"
    aria-label={`Controles de la galería de ${label}`}
    hidden
  >
    <button
      class="project-gallery-control"
      type="button"
      data-gallery-previous
      aria-label={`Ver captura anterior de ${label}`}
      hidden
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="m14.5 5-7 7 7 7" />
      </svg>
    </button>
    <output class="project-gallery-status" data-gallery-status aria-live="polite" aria-atomic="true">
      1 de {images.length}
    </output>
    <button
      class="project-gallery-control"
      type="button"
      data-gallery-next
      aria-label={`Ver siguiente captura de ${label}`}
      hidden
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="m9.5 5 7 7-7 7" />
      </svg>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-project-gallery]').forEach((gallery) => {
    const viewport = gallery.querySelector<HTMLElement>('[data-gallery-viewport]');
    const originalSlides = Array.from(gallery.querySelectorAll<HTMLElement>('[data-gallery-slide]'));
    const previous = gallery.querySelector<HTMLButtonElement>('[data-gallery-previous]');
    const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');
    const status = gallery.querySelector<HTMLOutputElement>('[data-gallery-status]');
    const controls = gallery.querySelector<HTMLElement>('[data-gallery-controls]');

    if (!viewport || !previous || !next || !status || !controls || originalSlides.length === 0) return;

    const track = originalSlides[0].parentElement;
    if (!track) return;

    let virtualSlides: HTMLElement[] = [];
    let activeIndex = 0;
    let activeVirtualIndex = 1;
    let settleTimer = 0;
    let initialized = false;
    let measuredWidth = 0;

    const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const setScrollPosition = (virtualIndex: number, behavior: ScrollBehavior) => {
      viewport.scrollTo({ left: virtualIndex * viewport.clientWidth, behavior });
    };

    const setScrollPositionImmediately = (virtualIndex: number) => {
      viewport.dataset.galleryJump = 'true';
      setScrollPosition(virtualIndex, 'auto');
      requestAnimationFrame(() => delete viewport.dataset.galleryJump);
    };

    const nearestSlideIndex = () => {
      if (viewport.clientWidth === 0) return activeVirtualIndex;
      return Math.max(0, Math.min(virtualSlides.length - 1, Math.round(viewport.scrollLeft / viewport.clientWidth)));
    };

    const syncAccessibleState = (virtualIndex: number) => {
      activeVirtualIndex = virtualIndex;
      activeIndex = virtualIndex === 0
        ? originalSlides.length - 1
        : virtualIndex === originalSlides.length + 1
          ? 0
          : virtualIndex - 1;

      originalSlides.forEach((slide, index) => {
        if (index === activeIndex) slide.setAttribute('aria-current', 'true');
        else slide.removeAttribute('aria-current');
      });

      status.textContent = `${activeIndex + 1} de ${originalSlides.length}`;
    };

    const finishScroll = () => {
      const nearestIndex = nearestSlideIndex();
      syncAccessibleState(nearestIndex);

      if (nearestIndex === 0 || nearestIndex === originalSlides.length + 1) {
        const realIndex = nearestIndex === 0 ? originalSlides.length : 1;
        viewport.dataset.galleryJump = 'true';
        setScrollPosition(realIndex, 'auto');
        activeVirtualIndex = realIndex;
        requestAnimationFrame(() => delete viewport.dataset.galleryJump);
      }
    };

    const onScroll = () => {
      activeVirtualIndex = nearestSlideIndex();
      window.clearTimeout(settleTimer);
      settleTimer = window.setTimeout(finishScroll, 140);
    };

    const showAdjacentSlide = (direction: -1 | 1) => {
      const targetIndex = activeVirtualIndex + direction;
      const target = virtualSlides[targetIndex];
      if (!target) return;
      activeVirtualIndex = targetIndex;
      if (reducedMotion()) setScrollPositionImmediately(targetIndex);
      else setScrollPosition(targetIndex, 'smooth');
    };

    const initialize = () => {
      if (viewport.clientWidth === 0) return;

      if (initialized) {
        if (measuredWidth !== viewport.clientWidth) {
          measuredWidth = viewport.clientWidth;
          setScrollPositionImmediately(activeVirtualIndex);
        }
        return;
      }

      initialized = true;
      measuredWidth = viewport.clientWidth;

      const before = originalSlides[originalSlides.length - 1].cloneNode(true) as HTMLElement;
      const after = originalSlides[0].cloneNode(true) as HTMLElement;
      [before, after].forEach((clone) => {
        clone.setAttribute('aria-hidden', 'true');
        clone.inert = true;
        clone.removeAttribute('aria-current');
        clone.querySelectorAll<HTMLElement>('[aria-current]').forEach((element) => element.removeAttribute('aria-current'));
        clone.querySelectorAll<HTMLImageElement>('img').forEach((image) => { image.alt = ''; });
      });

      track.prepend(before);
      track.append(after);
      virtualSlides = Array.from(track.querySelectorAll<HTMLElement>('[data-gallery-slide]'));
      setScrollPositionImmediately(1);
      activeVirtualIndex = 1;
      activeIndex = 0;
      status.textContent = `1 de ${originalSlides.length}`;

      viewport.addEventListener('scroll', onScroll, { passive: true });
      previous.addEventListener('click', () => showAdjacentSlide(-1));
      next.addEventListener('click', () => showAdjacentSlide(1));
      previous.hidden = false;
      next.hidden = false;
      controls.hidden = false;
    };

    const panel = gallery.closest<HTMLElement>('[data-project-panel]');
    panel?.addEventListener('project-panel-shown', initialize);

    if ('ResizeObserver' in window) {
      const observer = new ResizeObserver(initialize);
      observer.observe(viewport);
    } else {
      window.addEventListener('resize', initialize, { passive: true });
    }

    initialize();
  });
</script>

<style>
  .project-gallery {
    position: relative;
    min-width: 0;
  }

  .project-gallery-viewport {
    overflow-x: auto;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    background: var(--surface-panel);
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-color: var(--border-control) var(--surface-muted);
    scrollbar-width: thin;
    touch-action: pan-x pan-y;
  }

  .project-gallery-viewport[data-gallery-jump] {
    scroll-behavior: auto;
    scroll-snap-type: none;
  }

  .project-gallery-viewport:focus-visible {
    outline: 2px solid var(--interactive-accent);
    outline-offset: 3px;
  }

  .project-gallery-track {
    display: flex;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-gallery-slide {
    min-width: 0;
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .project-gallery-slide figure,
  .project-gallery-slide picture,
  .project-gallery-slide img {
    width: 100%;
    aspect-ratio: 16 / 10;
  }

  .project-gallery-slide figure {
    margin: 0;
    overflow: hidden;
  }

  .project-gallery-slide img {
    object-fit: cover;
  }

  .project-gallery-controls {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem;
    grid-template-rows: minmax(0, 1fr) auto;
    align-items: center;
    padding: 0.75rem;
    pointer-events: none;
  }

  .project-gallery-controls[hidden],
  .project-gallery-control[hidden] {
    display: none;
  }

  .project-gallery-control {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid var(--border-control);
    border-radius: var(--radius-button);
    background: color-mix(in srgb, var(--surface-card) 88%, transparent);
    color: var(--text-primary);
    cursor: pointer;
    pointer-events: auto;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      background-color 180ms ease;
  }

  .project-gallery-control:hover:not(:disabled) {
    transform: translateY(-2px);
    border-color: var(--hero-emphasis-color);
    color: var(--hero-emphasis-color);
  }

  .project-gallery-control:focus-visible {
    outline: 2px solid var(--interactive-accent);
    outline-offset: 2px;
  }

  .project-gallery-control[data-gallery-previous] {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
  }

  .project-gallery-control[data-gallery-next] {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
  }

  .project-gallery-control:disabled {
    cursor: default;
    opacity: 0.55;
  }

  .project-gallery-control svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .project-gallery-status {
    grid-column: 2;
    grid-row: 2;
    justify-self: center;
    min-width: 4rem;
    margin-block-end: 0.1rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--surface-card) 90%, transparent);
    color: var(--text-secondary);
    font-size: var(--text-caption);
    text-align: center;
    backdrop-filter: blur(10px);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-gallery-viewport {
      scroll-behavior: auto;
    }

    .project-gallery-control {
      transition: none;
    }

    .project-gallery-control:hover:not(:disabled) {
      transform: none;
    }
  }
</style>
