    line-height: 1.65;
    text-wrap: pretty;
  }

  .hero-name {
    color: var(--hero-emphasis-color);
    font-weight: 600;
  }

  /* CTA del hero: acción Ember principal y alternativa de borde */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block: 0 clamp(2rem, 6vw, 3.5rem);
  }

  .hero-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
