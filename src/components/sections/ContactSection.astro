---
import MandrillPulse from '../ui/MandrillPulse.astro';

// WhatsApp usa el formato móvil de México (+52 1) para abrir el chat.
const whatsappMessage = 'Buen día, Jesus. Me gustaría agendar una sesión de análisis técnico y conversar sobre mi proyecto.';
const whatsappUrl = `https://api.whatsapp.com/send?phone=5215615912984&text=${encodeURIComponent(whatsappMessage)}`;
---

<section class="contact-section" id="contacto" aria-labelledby="contact-title">
  <div class="page-container">
    <h2 class="contact-kicker" id="contact-title">
      <span class="contact-kicker-icon" aria-hidden="true"></span>
      <span>Contacto</span>
    </h2>
    <!-- Contenido y disposición recuperados de chatgpt/src/pages/index.astro. -->
    <article class="contact-card" aria-labelledby="conversation-title">
      <p class="conversation-kicker">Siguiente conversación</p>
      <h3 class="conversation-title" id="conversation-title">¿Hay un sistema complejo que necesita orden?</h3>
      <!-- En móvil se conserva el orden de lectura: etiqueta y título, mandril, texto y botones. -->
      <div class="contact-logo"><MandrillPulse /></div>
      <div class="conversation-paragraphs">
        <p>Agendemos una <strong>sesión de análisis técnico</strong> y conversemos sobre tus <strong>requerimientos</strong>.</p>
        <p>Juntos podemos crear una <strong>arquitectura sólida</strong>, desarrollar <strong>automatización documental</strong>, integrar <strong>inteligencia artificial aplicada</strong> o crear una <strong>plataforma de datos</strong> que evolucione sin perder <strong>control</strong>.</p>
        <p>Construyamos una <strong>solución de alto impacto</strong>.</p>
      </div>
      <div class="contact-actions">
        <div class="contact-email-control" data-contact-email>
          <button
            class="contact-button contact-button-primary contact-email-trigger"
            type="button"
            aria-haspopup="dialog"
            aria-controls="contact-email-dialog"
          >
            <span>Enviar correo</span>
            <span class="contact-email-arrow" aria-hidden="true"></span>
          </button>
        </div>
        <a class="contact-button contact-button-secondary" href="https://www.linkedin.com/in/arellano-jesus/" target="_blank" rel="noopener noreferrer">
          <span class="linkedin-icon" aria-hidden="true"></span>
          <span>LinkedIn</span>
        </a>
        <a class="contact-button contact-button-secondary" href="tel:+525615912984" aria-label="Llamar">
          <span class="phone-icon contact-action-icon" aria-hidden="true"></span>
          <span>Realiza una Llamada</span>
        </a>
        <a class="contact-button contact-button-secondary" href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="Enviar mensaje por WhatsApp al +52 56 1591 2984">
          <span class="whatsapp-icon contact-action-icon" aria-hidden="true"></span>
          <span>Enviar mensaje por WhatsApp</span>
        </a>
      </div>
    </article>
  </div>
  <dialog class="contact-email-dialog" id="contact-email-dialog" aria-labelledby="contact-email-title" aria-describedby="contact-email-description">
    <button class="contact-email-close" type="button" aria-label="Cerrar opciones de correo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
    </button>
    <p class="contact-email-eyebrow">Iniciemos una conversación</p>
    <h3 id="contact-email-title">Enviar correo</h3>
    <p class="contact-email-description" id="contact-email-description">Elige a quién quieres escribir. Se abrirá tu aplicación de correo para preparar el mensaje.</p>
    <div class="contact-email-options">
      <button class="contact-email-option" type="button" data-recipient="jesus" autofocus>
        <span><strong>Jesus Arellano</strong><span>Una conversación directa sobre tu proyecto</span></span>
        <span class="contact-email-arrow" aria-hidden="true"></span>
      </button>
      <button class="contact-email-option" type="button" data-recipient="alexandria">
        <span><strong>Alexandria Studio</strong><span>Proyectos y colaboraciones con el estudio</span></span>
        <span class="contact-email-arrow" aria-hidden="true"></span>
      </button>
    </div>
  </dialog>
</section>

<style>
  .contact-section {
    position: relative;
    padding-block: clamp(5rem, 10vw, 8rem);
    background: var(--surface-page);
  }

  .contact-section::before {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-subtle) 20%, var(--interactive-accent) 50%, var(--border-subtle) 80%, transparent);
    content: '';
    opacity: 0.85;
  }

  .contact-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1rem;
    color: var(--hero-emphasis-color);
    font-size: 0.75rem;
    font-weight: var(--font-weight-regular);
    letter-spacing: 0.12em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .contact-kicker::before {
    width: 1.25rem;
    height: 1px;
    flex: 0 0 auto;
    background: currentColor;
    content: '';
  }

  /* Copia de resources/contact_icon.svg; la máscara hereda el color del tema. */
  .contact-kicker-icon {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    background: currentColor;
    mask: url('/jesusarellano/images/icons/contact-icon.svg') center / contain no-repeat;
    -webkit-mask: url('/jesusarellano/images/icons/contact-icon.svg') center / contain no-repeat;
  }

  .contact-card {
    --contact-card-padding: clamp(1.5rem, 4vw, 3rem);
    --contact-edge: color-mix(in srgb, var(--interactive-accent) 38%, var(--border-subtle));
    --contact-glow: color-mix(in srgb, var(--interactive-accent) 14%, transparent);
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    grid-template-areas: 'kicker kicker' 'title title' 'logo paragraphs' 'actions actions';
    column-gap: clamp(1.5rem, 4vw, 3rem);
    row-gap: 2rem;
    margin-block-start: 1rem;
    padding: var(--contact-card-padding);
    overflow: hidden;
    border: 1px solid var(--contact-edge);
    border-radius: var(--radius-panel);
    background:
      radial-gradient(ellipse at 100% 0%, var(--ambient-ember), transparent 60%),
      radial-gradient(ellipse at 0% 100%, var(--ambient-current), transparent 65%),
      linear-gradient(135deg, var(--surface-card), var(--surface-panel));
    /* Halo decorativo solicitado: ilumina el contorno sin simular elevación. */
    box-shadow: 0 0 2rem var(--contact-glow), inset 0 0 1.5rem var(--contact-glow);
  }

  .conversation-kicker {
    display: flex;
    align-items: center;
    grid-area: kicker;
    gap: 0.65rem;
    margin: 0 0 -1rem;
    color: var(--text-secondary);
    font-size: var(--text-caption);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .conversation-kicker::before {
    width: 1.5rem;
    height: 1px;
    background: var(--gradient-electric-current);
    content: '';
  }

  .conversation-title {
    grid-area: title;
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(2.75rem, 5vw, 4.4rem);
    font-weight: var(--font-weight-light);
    letter-spacing: -0.05em;
    line-height: 0.98;
    text-wrap: balance;
  }

  /* El mandril comparte la franja de contenido en la columna izquierda. */
  .contact-logo {
    /* Mitad de la escala de escritorio anterior, centrada en la columna. */
    --mandrill-width: 75%;
    --mandrill-offset: 12.5%;
    position: relative;
    isolation: isolate;
    display: grid;
    grid-area: logo;
    align-content: center;
    width: 100%;
    min-width: 0;
    align-self: stretch;
  }

  /* Misma cuadrícula del hero: trama de 60px y líneas adaptadas al tema. */
  .contact-logo::before {
    position: absolute;
    inset-block: calc(-1 * var(--contact-card-padding));
    inset-inline-start: calc(-1 * var(--contact-card-padding));
    inset-inline-end: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-position: center;
    background-size: 3.75rem 3.75rem;
    mask-image: linear-gradient(to bottom, rgb(0 0 0 / 78%), transparent 96%);
    pointer-events: none;
    content: '';
  }
  .conversation-paragraphs p { margin: 0; color: var(--text-secondary); line-height: 1.65; }
  .conversation-paragraphs { display: grid; grid-area: paragraphs; gap: 1rem; min-width: 0; max-width: 48rem; }
  .conversation-paragraphs strong { color: var(--hero-emphasis-color); font-weight: var(--font-weight-regular); }

  .contact-actions {
    display: grid;
    grid-area: actions;
    grid-template-columns: repeat(4, 16.625rem);
    justify-content: space-between;
    gap: 0.8rem;
    min-width: 0;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--border-subtle);
  }

  .contact-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.875rem 1.25rem;
    border-radius: var(--radius-button);
    font-size: var(--text-body-sm);
    text-decoration: none;
    text-shadow: none;
  }
  .contact-button,
  .contact-email-option {
    transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease, filter 180ms ease, transform 140ms ease;
  }

  .contact-button span { min-width: 0; overflow-wrap: anywhere; white-space: nowrap; }
  .contact-button svg {
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 auto;
  }
  .contact-button-primary { background: var(--gradient-ember-cta); color: var(--text-on-ember); }
  .contact-button:hover,
  .contact-email-option:hover { transform: translateY(-0.125rem); text-decoration: none; }
  .contact-button:active,
  .contact-email-option:active { transform: translateY(0) scale(0.98); }
  .contact-button-primary:hover { filter: saturate(112%) brightness(1.04); }
  .contact-button-secondary {
    border: 1px solid var(--border-control);
    color: var(--text-primary);
    background: color-mix(in srgb, var(--surface-muted) 72%, transparent);
    backdrop-filter: blur(0.75rem);
    -webkit-backdrop-filter: blur(0.75rem);
  }
  .contact-button-secondary:hover,
  .contact-email-option:hover { border-color: var(--interactive-accent); color: var(--text-strong); background: var(--surface-muted); }

  .contact-email-control { position: relative; z-index: 2; min-width: 0; }
  .contact-email-trigger {
    width: 100%;
    border: 0;
    color: var(--text-on-ember);
    cursor: pointer;
    font-size: var(--text-body-sm);
    line-height: 1.4;
  }
  .contact-email-arrow {
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 auto;
    background: currentColor;
    mask: url('/jesusarellano/images/icons/arrow-icon.svg') center / contain no-repeat;
    -webkit-mask: url('/jesusarellano/images/icons/arrow-icon.svg') center / contain no-repeat;
  }
  .contact-email-dialog {
    width: min(32rem, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid color-mix(in srgb, var(--interactive-accent) 35%, var(--border-control));
    border-radius: var(--radius-panel);
    color: var(--text-primary);
    background: linear-gradient(135deg, var(--ambient-current), transparent 65%), color-mix(in srgb, var(--surface-card) 88%, transparent);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 1.5rem 5rem color-mix(in srgb, var(--surface-page) 55%, transparent), 0 0 2rem var(--ambient-current);
    opacity: 0;
    transform: translateY(0.75rem) scale(0.985);
    transition: opacity 220ms ease, transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .contact-email-dialog.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .contact-email-dialog.is-closing {
    opacity: 0;
    transform: translateY(0.75rem) scale(0.985);
  }
  .contact-email-dialog::backdrop {
    background-color: transparent;
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
    transition: background-color 220ms ease, backdrop-filter 220ms ease, -webkit-backdrop-filter 220ms ease;
  }
  .contact-email-dialog.is-visible::backdrop {
    background-color: color-mix(in srgb, var(--surface-page) 58%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  :global(html:has(.contact-email-dialog[open])) { overflow: hidden; }
  .contact-email-close {
    position: absolute;
    inset-block-start: 0.75rem;
    inset-inline-end: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border-control);
    border-radius: var(--radius-button);
    background: var(--surface-muted);
    color: var(--text-primary);
    cursor: pointer;
  }
  .contact-email-close svg { width: 1.25rem; height: 1.25rem; }
  .contact-email-eyebrow { margin: 0 2rem 0.75rem 0; color: var(--hero-emphasis-color); font-size: var(--text-caption); }
  .contact-email-dialog h3 { margin: 0; font-size: clamp(1.75rem, 4vw, 2.25rem); font-weight: var(--font-weight-light); }
  .contact-email-description { margin: 1rem 0 1.5rem; color: var(--text-secondary); line-height: 1.6; }
  .contact-email-options { display: grid; gap: 0.75rem; }
  .contact-email-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    padding: 1rem;
    border: 1px solid var(--border-control);
    border-radius: var(--radius-button);
    background: color-mix(in srgb, var(--surface-muted) 72%, transparent);
    color: var(--text-primary);
    cursor: pointer;
    font-size: var(--text-body-sm);
    line-height: 1.4;
    text-align: start;
    backdrop-filter: blur(0.75rem);
    -webkit-backdrop-filter: blur(0.75rem);
  }
  .contact-email-option > span:first-child { display: grid; gap: 0.35rem; }
  .contact-email-option strong { font-weight: var(--font-weight-regular); }
  .contact-email-option > span > span { color: var(--text-secondary); font-size: var(--text-caption); line-height: 1.5; }
  .contact-email-trigger:focus-visible,
  .contact-email-close:focus-visible,
  .contact-email-option:focus-visible { outline: 2px solid var(--interactive-accent); outline-offset: 2px; }

  /* Copia de resources/linkedin_icon.svg, teñida con el color de la acción. */
  .linkedin-icon {
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 auto;
    background: currentColor;
    mask: url('/jesusarellano/images/social/linkedin-contact.svg') center / contain no-repeat;
    -webkit-mask: url('/jesusarellano/images/social/linkedin-contact.svg') center / contain no-repeat;
  }

  /* Copias de resources/phone_icon.svg y resources/whatsapp_icon.svg. */
  .contact-action-icon {
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 auto;
    background: currentColor;
  }
  .phone-icon {
    mask: url('/jesusarellano/images/icons/phone-icon.svg') center / contain no-repeat;
    -webkit-mask: url('/jesusarellano/images/icons/phone-icon.svg') center / contain no-repeat;
  }
  .whatsapp-icon {
    mask: url('/jesusarellano/images/social/whatsapp.svg') center / contain no-repeat;
    -webkit-mask: url('/jesusarellano/images/social/whatsapp.svg') center / contain no-repeat;
  }

  @media (max-width: 84rem) and (min-width: 48.001rem) {
    .contact-actions { grid-template-columns: repeat(2, 16.625rem); }
  }

  @media (max-width: 48rem) {
    .contact-card {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'kicker' 'title' 'logo' 'paragraphs' 'actions';
    }
    .contact-logo {
      --mandrill-width: 100%;
      --mandrill-offset: 0;
      width: min(100%, 16rem);
      justify-self: center;
    }
    .contact-logo::before { inset: -1rem; }
    .contact-actions { grid-template-columns: minmax(0, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-button,
    .contact-email-option,
    .contact-email-dialog,
    .contact-email-dialog::backdrop { transition: none; }
    .contact-button:hover,
    .contact-button:active,
    .contact-email-option:hover,
    .contact-email-option:active { transform: none; }
  }
</style>

<script>
  const emailTargets: Record<string, string> = {
    jesus: 'mailto:jarellanof.soporte@gmail.com',
    alexandria: 'mailto:jesus.arellano@alexandriastudio.cloud',
  };

  document.querySelectorAll<HTMLElement>('[data-contact-email]').forEach((control) => {
    const trigger = control.querySelector<HTMLButtonElement>('.contact-email-trigger');
    const dialog = document.getElementById('contact-email-dialog') as HTMLDialogElement | null;
    if (!trigger || !dialog) return;

    let closeTimer: number | undefined;
    const finishClose = () => {
      if (dialog.open) dialog.close();
      dialog.classList.remove('is-visible', 'is-closing');
    };
    const closeDialog = () => {
      if (!dialog.open || dialog.classList.contains('is-closing')) return;
      dialog.classList.remove('is-visible');
      dialog.classList.add('is-closing');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        finishClose();
        return;
      }
      closeTimer = window.setTimeout(finishClose, 280);
    };

    trigger.addEventListener('click', () => {
      if (dialog.open) return;
      dialog.showModal();
      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(() => {
          if (dialog.open && !dialog.classList.contains('is-closing')) dialog.classList.add('is-visible');
        });
      });
    });

    dialog.querySelectorAll<HTMLButtonElement>('[data-recipient]').forEach((option) => {
      option.addEventListener('click', () => {
        const mailto = emailTargets[option.dataset.recipient ?? ''];
        if (mailto) window.location.assign(mailto);
        closeDialog();
      });
    });

    dialog.querySelector('.contact-email-close')?.addEventListener('click', closeDialog);
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeDialog();
    });
    dialog.addEventListener('close', () => {
      window.clearTimeout(closeTimer);
      dialog.classList.remove('is-visible', 'is-closing');
    });
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return;
      const bounds = dialog.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) closeDialog();
    });
  });
</script>
