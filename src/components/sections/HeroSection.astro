<!-- =========================================================================
     HERO
     Presentación principal con cuadrícula, degradado y animación WebGL v9.
     ========================================================================= -->
<section class="hero" id="inicio" aria-labelledby="hero-title">
  <!-- Capas atmosféricas decorativas del sistema visual del portafolio -->
  <div class="hero-atmosphere" aria-hidden="true"></div>
  <div class="hero-grid" aria-hidden="true"></div>

  <!-- Visual principal: fondo completo en escritorio y primera pieza del flujo en móvil -->
  <div
    class="mandrill-animation"
    id="mandrill-animation"
    data-mode="generated"
    aria-hidden="true"
  >
    <!-- Video original visible solo en el modo dividido de escritorio -->
    <video id="sourceVideo" muted playsinline preload="none"></video>
    <canvas id="glyphs"></canvas>
    <canvas id="vectors"></canvas>

    <!-- Controles de compatibilidad del proyecto v9; no forman parte de la interfaz visible -->
    <div hidden>
      <button id="togglePlayback" type="button">Pausar</button>
      <button id="replay" type="button">Reiniciar</button>
      <input id="speedControl" type="range" min="0.30" max="1.25" step="0.05" value="0.65" />
      <output id="speedValue" for="speedControl">0.65×</output>
    </div>

    <noscript>La animación decorativa requiere JavaScript.</noscript>
  </div>

  <div class="page-container hero-layout">
    <!-- Contenido principal disponible sin depender de la animación -->
    <div class="hero-copy">
      <p class="hero-eyebrow">Development, AI &amp; Data Architect</p>
      <h1 id="hero-title">
        Desarrollo, inteligencia y datos <span class="hero-highlight">conectados.</span>
      </h1>
      <p class="hero-introduction">
        Hola, soy <strong class="hero-name">Jesus Arellano</strong> y diseño soluciones digitales
        donde software, inteligencia artificial y datos trabajan como un solo sistema.
      </p>
    </div>
  </div>

  <!-- Acciones principales: ocupan una franja libre debajo del video en escritorio -->
  <div class="page-container hero-actions" aria-label="Enlaces destacados">
    <a class="hero-action hero-action-primary" href="#proyectos">
      <span>Explorar Proyectos</span>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </a>
    <a class="hero-action hero-action-secondary" href="#contacto">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3.5" y="5" width="17" height="14" rx="2" />
        <path d="m5 7 7 5 7-5" />
      </svg>
      <span>Iniciar conversación</span>
    </a>
  </div>
</section>

<!-- =========================================================================
     RESUMEN PROFESIONAL
     Enlaces públicos y datos de trayectoria solicitados para contextualizar el perfil.
     ========================================================================= -->
<section class="profile-summary" id="resumen-profesional" aria-label="Resumen profesional">
  <div class="page-container profile-summary-content">
    <!-- Enlaces externos autorizados y ubicación profesional general -->
    <div class="profile-links">
      <a
        class="profile-external-link"
        href="https://www.linkedin.com/in/arellano-jesus/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="profile-icon profile-icon-linkedin" aria-hidden="true"></span>
        <span>LinkedIn</span>
      </a>
      <a
        class="profile-external-link"
        href="https://github.com/rab-Dos"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="profile-icon profile-icon-github" aria-hidden="true"></span>
        <span>GitHub</span>
      </a>
      <p class="profile-location">Ciudad de México · MX</p>
    </div>

    <!-- Barra de atributos profesionales, adaptable de cuatro a una columna -->
    <dl class="profile-facts">
      <div class="profile-fact">
        <dt>Trayectoria</dt>
        <dd>2011 — Actualidad</dd>
      </div>
      <div class="profile-fact">
        <dt>Especialización</dt>
        <dd>Arquitectura · IA · Datos · Web</dd>
      </div>
      <div class="profile-fact">
        <dt>Entornos</dt>
        <dd>Enterprise · Operación crítica</dd>
      </div>
      <div class="profile-fact">
        <dt>Enfoque</dt>
        <dd>Impacto sobre complejidad</dd>
      </div>
    </dl>
  </div>
</section>

