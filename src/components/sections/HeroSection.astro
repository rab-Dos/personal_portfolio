    padding: 0.75rem 1.25rem;
    border: 1px solid transparent;
    border-radius: var(--radius-button);
    font-size: var(--text-body-sm);
    font-weight: var(--font-weight-regular);
    line-height: 1.4;
    text-decoration: none;
    text-shadow: none;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 140ms ease;
  }

  .hero-action svg {
    width: 1.125rem;
    height: 1.125rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .hero-action-primary {
    background: var(--gradient-ember-cta);
    color: var(--text-on-ember);
  }

  .hero-action-secondary {
    border-color: var(--border-control);
    background: color-mix(in srgb, var(--surface-page) 38%, transparent);
    color: var(--text-strong);
    backdrop-filter: blur(0.75rem);
    -webkit-backdrop-filter: blur(0.75rem);
  }

  .hero-action:hover {
    transform: translateY(-0.125rem);
  }

  .hero-action-primary:hover {
    filter: saturate(112%) brightness(1.04);
  }

  .hero-action-secondary:hover {
    border-color: var(--interactive-accent);
    background: color-mix(in srgb, var(--surface-muted) 62%, transparent);
  }

  .hero-action:active {
    transform: translateY(0) scale(0.98);
  }

  /* Canvas WebGL y vectorial sin superficie propia: dejan ver degradado y rejilla */
  .mandrill-animation {
    position: relative;
    place-self: center;
    width: min(calc(100% - 2rem), 34rem);
    aspect-ratio: 4 / 3;
    overflow: visible;
    background: transparent;
    pointer-events: none;
  }

  .mandrill-animation canvas,
  #sourceVideo {
    position: absolute;
    inset-block: 0;
    height: 100%;
    background: transparent;
  }

  #sourceVideo {
    display: none;
    object-fit: cover;
  }

  #glyphs {
    inset-inline-start: 0;
    width: 100%;
  }

  #vectors {
    inset-inline: 0;
    width: 100%;
    z-index: 2;
  }

  /* Centrado óptico de la máscara en el espacio móvil reservado */
  .mandrill-animation[data-mode='generated'] #glyphs,
  .mandrill-animation[data-mode='generated'] #vectors {
    translate: 0 4%;
  }

  /* El modo dividido recupera el video fuente y las conexiones entre ambas vistas */
  .mandrill-animation[data-mode='split'] #sourceVideo {
    display: block;
    inset-inline-start: 0;
    width: 52%;
    mask-image: linear-gradient(to right, #000 0 88%, rgb(0 0 0 / 78%) 94%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, #000 0 88%, rgb(0 0 0 / 78%) 94%, transparent 100%);
  }

  .mandrill-animation[data-mode='split'] #glyphs {
    inset-inline-start: 48%;
    width: 52%;
    mask-image: linear-gradient(to right, transparent 0, rgb(0 0 0 / 42%) 7%, #000 18% 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, rgb(0 0 0 / 42%) 7%, #000 18% 100%);
  }

  /* Desenfoque del solape: elimina la división plana entre video y máscara */
  .mandrill-animation[data-mode='split']::after {
    position: absolute;
    inset-block: 5%;
    inset-inline-start: 44%;
    z-index: 1;
    width: 12%;
    background: linear-gradient(90deg, transparent, rgb(14 9 24 / 8%), transparent);
    backdrop-filter: blur(1.125rem);
    -webkit-backdrop-filter: blur(1.125rem);
    content: '';
    mask-image: linear-gradient(90deg, transparent, #000 30% 70%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 30% 70%, transparent);
  }

  .mandrill-animation.no-webgl::after {
    position: absolute;
    inset: 15%;
    border: 1px solid var(--border-subtle);
    border-radius: 50%;
    content: '';
    opacity: 0.45;
  }

  @media (min-width: 56rem) {
    .hero {
